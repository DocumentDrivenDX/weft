{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DocumentDrivenDX/weft/raw/main/docs/helix/02-design/contracts/application-result-v0.2.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/presence"
    },
    {
      "$ref": "#/$defs/relatedKeys"
    }
  ],
  "$defs": {
    "presence": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "absent"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "null"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "value"
            },
            "value": {}
          },
          "required": [
            "state",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "relatedKeys": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "items",
        "truncated"
      ],
      "additionalProperties": false
    }
  }
}
