{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "pathCollection": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "intermediate": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "terminal": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(0|-?[1-9][0-9]*)$",
                  "maxLength": 20
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "intermediate",
              "terminal",
              "edges"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "items",
        "truncated"
      ],
      "additionalProperties": false
    },
    "pathPresence": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "absent"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "value"
            },
            "value": {
              "$ref": "#/$defs/pathCollection"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/pathCollection"
    },
    {
      "$ref": "#/$defs/pathPresence"
    }
  ],
  "$id": "https://github.com/DocumentDrivenDX/weft/raw/main/docs/helix/02-design/contracts/application-result-v0.4.schema.json"
}
