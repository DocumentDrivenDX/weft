{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:weft:current-presence:designation-profile:0.1-candidate",
  "type": "object",
  "properties": {
    "version": {
      "const": "weft.current-presence.designation-profile/0.1-candidate"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "modelPins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "umfVersion": {
            "const": "0.8.0"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "documentId",
          "revision",
          "umfVersion",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "policy",
              "ontology",
              "catalog",
              "owner"
            ]
          },
          "identity": {
            "type": "object",
            "properties": {
              "documentId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "documentId",
              "revision"
            ],
            "additionalProperties": false
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "role",
          "identity",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "binding": {
      "type": "object",
      "properties": {
        "backendId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "backendVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "targetProfile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source": {
          "type": "object",
          "properties": {
            "documentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "documentId",
            "revision"
          ],
          "additionalProperties": false
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "backendId",
        "backendVersion",
        "targetProfile",
        "source",
        "sha256"
      ],
      "additionalProperties": false
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "moduleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "elementId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "documentId",
          "moduleId",
          "elementId"
        ],
        "additionalProperties": false
      }
    },
    "primaryAction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "capabilities": {
      "const": [
        "tagged-current-projection"
      ]
    },
    "producer": {
      "type": "object",
      "required": [
        "protocol",
        "entrypoint"
      ],
      "properties": {
        "protocol": {
          "const": "umf.security.logical-disclosure-batch/0.1-candidate"
        },
        "entrypoint": {
          "const": "evaluateCandidateCatalogReadDisclosureBatchWithinOperation"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "id",
    "revision",
    "modelPins",
    "sources",
    "binding",
    "targets",
    "primaryAction",
    "capabilities",
    "producer"
  ],
  "additionalProperties": false
}
