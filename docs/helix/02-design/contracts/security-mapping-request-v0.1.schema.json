{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DocumentDrivenDX/weft/raw/main/docs/helix/02-design/contracts/security-mapping-request-v0.1.schema.json",
  "type": "object",
  "properties": {
    "interfaceVersion": {
      "const": "weft-security-mapping/0.1.0"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "documentJson": {
            "type": "string",
            "minLength": 1
          },
          "pin": {
            "type": "object",
            "properties": {
              "documentId": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "umfVersion": {
                "enum": [
                  "0.10.0"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "documentId",
              "revision",
              "umfVersion",
              "sha256"
            ],
            "additionalProperties": false
          },
          "selectedModuleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "documentJson",
          "pin",
          "selectedModuleIds"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    },
    "policyJson": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000000
    },
    "ontologyJson": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000000
    },
    "queryProfileJson": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000000
    },
    "bindingJson": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000000
    },
    "sql": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000000
    },
    "backendId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "backendVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "targetProfile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "parameters": {
      "type": "object",
      "maxProperties": 1024,
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "family": {
            "enum": [
              "boolean",
              "string",
              "integer",
              "decimal"
            ]
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "family",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "readProfile": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "const": "weft-application-read/0.2.0"
            },
            "subset": {
              "enum": [
                "entity-page",
                "count-summary",
                "related-entity-page"
              ]
            }
          },
          "required": [
            "version",
            "subset"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "interfaceVersion",
    "modules",
    "policyJson",
    "ontologyJson",
    "queryProfileJson",
    "bindingJson",
    "sql",
    "backendId",
    "backendVersion",
    "targetProfile",
    "parameters"
  ],
  "additionalProperties": false
}
