{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:weft:application:lineage-request:0.3-candidate",
  "type": "object",
  "properties": {
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "documentJson": {
            "type": "string",
            "minLength": 1
          },
          "pin": {
            "type": "object",
            "properties": {
              "documentId": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "umfVersion": {
                "enum": ["0.8.0", "0.10.0"]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "documentId",
              "revision",
              "umfVersion",
              "sha256"
            ],
            "additionalProperties": false
          },
          "selectedModuleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "documentJson",
          "pin",
          "selectedModuleIds"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    },
    "sql": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000000
    },
    "parameters": {
      "type": "object",
      "maxProperties": 1024,
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "family": {
            "enum": [
              "boolean",
              "string",
              "integer",
              "decimal"
            ]
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "family",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "readProfile": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "const": "weft-application-read/0.2.0"
            },
            "subset": {
              "enum": [
                "entity-page",
                "count-summary",
                "related-entity-page"
              ]
            }
          },
          "required": [
            "version",
            "subset"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "interfaceVersion": {
      "const": "weft-application-lineage/0.3-candidate"
    },
    "opaqueSources": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "identity": {
            "type": "object",
            "properties": {
              "documentId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "documentId",
              "revision"
            ],
            "additionalProperties": false
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "utf8": {
            "type": "string",
            "maxLength": 4000000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "role",
          "identity",
          "mediaType",
          "utf8",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "interfaceVersion",
    "modules",
    "sql",
    "parameters",
    "opaqueSources"
  ],
  "additionalProperties": false
}
