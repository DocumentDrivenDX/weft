{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:weft:current-query-refinement-input:0.1-candidate",
  "title": "Conditional current-query refinement input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sourceRequestSha256",
    "designationSha256",
    "materializationBindingSha256",
    "compiledArtifactSha256",
    "scans",
    "resultRows"
  ],
  "properties": {
    "version": {
      "const": "weft.current-query.refinement-input/0.1-candidate"
    },
    "sourceRequestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "designationSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "materializationBindingSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compiledArtifactSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scans": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scan",
          "expectedRowCount",
          "rows"
        ],
        "properties": {
          "scan": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "expectedRowCount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,3}|10000)$"
          },
          "rows": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "cells"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "cells": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "family",
                          "value"
                        ],
                        "properties": {
                          "family": {
                            "const": "string"
                          },
                          "value": {
                            "type": "string"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "family",
                          "value"
                        ],
                        "properties": {
                          "family": {
                            "const": "integer"
                          },
                          "value": {
                            "type": "string",
                            "pattern": "^(0|-?[1-9][0-9]*)$",
                            "maxLength": 20
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "resultRows": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 1025,
        "items": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
