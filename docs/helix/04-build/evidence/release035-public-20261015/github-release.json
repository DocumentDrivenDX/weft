ithub-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":3205845,"digest":"sha256:51a8fdaf9c4f568fe912856c6a7271d67b060a56f367916fa2fe6ae22a21187a","download_count":0,"created_at":"2026-10-16T02:17:36Z","updated_at":"2026-10-16T02:17:37Z","browser_download_url":"https://github.com/DocumentDrivenDX/weft/releases/download/v0.4.35/weft_sql-0.4.35-cp39-abi3-win_amd64.whl"}],"tarball_url":"https://api.github.com/repos/DocumentDrivenDX/weft/tarball/v0.4.35","zipball_url":"https://api.github.com/repos/DocumentDrivenDX/weft/zipball/v0.4.35","body":"# Weft v0.4.35\n\nThis candidate release adds a conditional result-refinement checker to the\nstandard Python wheel and an explicit Truss query ABI backend.\n\nThe existing original `CurrentQueryPreparation` exposes five named checker\nmethods for PostgreSQL rows, contributor bags and exact integer SUM, and\nDatabricks contributor bags and SUM. The checker validates actual lowering and\ncompares complete captured inputs with public values and complete contributors.\nCONTRACT-010 specifies its closed frames, five digest anchors, exact types,\nSQL tie/limit semantics and pre-limit size limits. A match remains conditional:\n`authority=false`, `securityReady=false`, `nativeAdmission=required`.\n\nOrdinary Truss backend `0.4.38` selects binding/target `0.5` with exact query ABI\n`truss-postgresql-logical-query/1.0`. It supports directed owned and independent\nrelationship reads while preserving original binding bytes and all native\ninstallation/runtime/model checks. Earlier backend selections retain their\nclosed pins and reject the new binding. Mutation admission is unchanged.\n\nLocal evidence includes 338 core, 105 PostgreSQL library and 15 Databricks library\ntests, four query ABI compiler groups, 67 fresh PostgreSQL checker controls and\n229 offline controls over 22 retained managed Databricks queries. Release CI\nmust also pass all five platform wheel jobs, including 30 exact-wheel refinement\ncontrols per platform. Retained managed results are not a fresh cloud execution.\n\nThis release grants no native query permission and activates no protected\nconsumer cohort. B-008 remains open under all 132 original shared/native cases;\nauthenticated source/caller/current authority, complete native custody and guarded\nrelease require their own qualified host enforcement and evidence.\n"}