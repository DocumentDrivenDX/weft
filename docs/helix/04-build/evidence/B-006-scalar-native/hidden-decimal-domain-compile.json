    "sql": "WITH `s0` AS (SELECT CAST(CAST(variant_get(parse_json(r.props_json), :p4) AS STRING) AS DECIMAL(38,0)) AS `f0`, (CAST(CAST(variant_get(parse_json(r.props_json), :p5) AS STRING) AS STRING) COLLATE UTF8_BINARY) AS `f1` FROM `client_dev`.`weft_b006_20261008_scalar`.`object_current` VERSION AS OF 1 r WHERE (r.source_system COLLATE UTF8_BINARY) = (:p1 COLLATE UTF8_BINARY) AND r.type_id = CAST(:p2 AS BIGINT)), `s1` AS (SELECT CAST(CAST(variant_get(parse_json(r.props_json), :p9) AS STRING) AS DECIMAL(38,0)) AS `f0`, CAST(CAST(variant_get(parse_json(r.props_json), :p10) AS STRING) AS DECIMAL(38,2)) AS `f1` FROM `client_dev`.`weft_b006_20261008_scalar`.`object_current` VERSION AS OF 1 r WHERE (r.source_system COLLATE UTF8_BINARY) = (:p6 COLLATE UTF8_BINARY) AND r.type_id = CAST(:p7 AS BIGINT)) SELECT CAST((`s0`.`f1` COLLATE UTF8_BINARY) AS STRING) AS `name`, CAST(CASE WHEN COUNT(`s1`.`f1`) > 0 AND TRY_SUM(`s1`.`f1`) IS NULL THEN raise_error('WFT-NUMERIC-DOMAIN') ELSE TRY_SUM(`s1`.`f1`) END AS STRING) AS `total` FROM (`s0` INNER JOIN `s1` ON (`s1`.`f0` = `s0`.`f0`)) GROUP BY (`s0`.`f1` COLLATE UTF8_BINARY)",
