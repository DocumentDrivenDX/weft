{"label": "exact-decimal-carrier", "sql": "SELECT\n  cast(cast(:v AS DECIMAL(28,2)) AS STRING) AS exact_value,\n  cast(sum(cast(:v AS DECIMAL(28,2))) AS STRING) AS exact_sum\nFROM VALUES (1), (2) t(n) GROUP BY cast(:v AS DECIMAL(28,2))", "parameters": [{"name": "v", "type": "STRING", "value": "99999999999999999999999999.99"}], "response": {"statement_id": "01f1c2db-2259-1b89-b396-eb0ffa8c72ba", "status": {"state": "SUCCEEDED"}, "manifest": {"format": "JSON_ARRAY", "schema": {"column_count": 2, "columns": [{"name": "exact_value", "type_text": "STRING", "type_name": "STRING", "position": 0}, {"name": "exact_sum", "type_text": "STRING", "type_name": "STRING", "position": 1}]}, "total_chunk_count": 1, "chunks": [{"chunk_index": 0, "row_offset": 0, "row_count": 1}], "total_row_count": 1, "truncated": false}, "result": {"chunk_index": 0, "row_offset": 0, "row_count": 1, "data_array": [["99999999999999999999999999.99", "199999999999999999999999999.98"]]}}}
{"label": "json-text-observation", "sql": "SELECT\n  get_json_object(:payload, '$.23') AS exact_number,\n  get_json_object(:payload, '$.24') AS explicit_null,\n  get_json_object(:payload, '$.25') AS absent", "parameters": [{"name": "payload", "type": "STRING", "value": "{\"23\":18446744073709551615,\"24\":null}"}], "response": {"statement_id": "01f1c2db-22ba-13e6-9b1a-6e33b80901c7", "status": {"state": "SUCCEEDED"}, "manifest": {"format": "JSON_ARRAY", "schema": {"column_count": 3, "columns": [{"name": "exact_number", "type_text": "STRING", "type_name": "STRING", "position": 0}, {"name": "explicit_null", "type_text": "STRING", "type_name": "STRING", "position": 1}, {"name": "absent", "type_text": "STRING", "type_name": "STRING", "position": 2}]}, "total_chunk_count": 1, "chunks": [{"chunk_index": 0, "row_offset": 0, "row_count": 1}], "total_row_count": 1, "truncated": false}, "result": {"chunk_index": 0, "row_offset": 0, "row_count": 1, "data_array": [["18446744073709551615", null, null]]}}}
{"label": "sum-overflow-refuses", "sql": "SELECT sum(cast(:v AS DECIMAL(38,0)))\nFROM VALUES (1), (2) t(n)", "parameters": [{"name": "v", "type": "STRING", "value": "99999999999999999999999999999999999999"}], "response": {"statement_id": "01f1c2db-231b-14ea-b895-71a7ba13fc8e", "status": {"state": "FAILED", "error": {"error_code": "BAD_REQUEST", "message": "[ARITHMETIC_OVERFLOW] Overflow in sum of decimals. Use 'try_sum' to tolerate overflow and return NULL instead. If necessary set \"ansi_mode\" to \"false\" to bypass this error. SQLSTATE: 22003"}, "sql_state": "22003"}}}
