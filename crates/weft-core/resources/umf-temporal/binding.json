{
  "id": "umf.binding",
  "version": "0.1.0",
  "coreVersion": "0.10.0",
  "description": "Independent target-specific physical binding for a logical UMF document",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:umf:binding:0.1.0",
    "title": "UMF physical binding 0.1.0",
    "type": "object",
    "required": [
      "profile",
      "logical",
      "target",
      "elements",
      "fields",
      "relationships",
      "indexes"
    ],
    "properties": {
      "profile": {
        "const": "umf-binding-1"
      },
      "logical": {
        "type": "object",
        "required": [
          "documentId",
          "coreVersion"
        ],
        "properties": {
          "documentId": {
            "type": "string",
            "minLength": 1
          },
          "coreVersion": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          }
        }
      },
      "target": {
        "type": "object",
        "required": [
          "system",
          "version",
          "subset"
        ],
        "properties": {
          "system": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "subset": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "elements": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "module",
            "element"
          ],
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1
            },
            "element": {
              "type": "string",
              "minLength": 1
            },
            "partition": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "table": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "fields": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "module",
            "element",
            "storage"
          ],
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1
            },
            "element": {
              "type": "string",
              "minLength": 1
            },
            "storage": {
              "enum": [
                "column",
                "embedded"
              ]
            },
            "column": {
              "type": "string",
              "minLength": 1
            },
            "documentColumn": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "$ref": "#/$defs/path"
            },
            "field": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "storage": {
                    "const": "embedded"
                  }
                },
                "required": [
                  "storage"
                ]
              },
              "then": {
                "required": [
                  "documentColumn",
                  "path"
                ],
                "properties": {
                  "documentColumn": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "$ref": "#/$defs/path"
                  }
                }
              },
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "documentColumn"
                      ]
                    },
                    {
                      "required": [
                        "path"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "relationships": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "module",
            "name",
            "storage"
          ],
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "storage": {
              "enum": [
                "edge",
                "foreign_key",
                "junction",
                "inline"
              ]
            }
          }
        }
      },
      "indexes": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/index"
        }
      }
    },
    "$defs": {
      "elementRef": {
        "type": "object",
        "required": [
          "module",
          "element"
        ],
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1
          },
          "element": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "relationshipRef": {
        "type": "object",
        "required": [
          "module",
          "name"
        ],
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "path": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "indexTarget": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "$ref": "#/$defs/elementRef"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "documentPath"
            ],
            "properties": {
              "documentPath": {
                "type": "object",
                "required": [
                  "field",
                  "path"
                ],
                "properties": {
                  "field": {
                    "$ref": "#/$defs/elementRef"
                  },
                  "path": {
                    "$ref": "#/$defs/path"
                  }
                }
              }
            }
          }
        ]
      },
      "index": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "on",
          "unique"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "btree",
              "hash",
              "gin",
              "gist",
              "expression",
              "partial",
              "unique",
              "clustering"
            ]
          },
          "on": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/indexTarget"
            }
          },
          "predicate": {
            "type": "object",
            "required": [
              "language",
              "version",
              "expression"
            ],
            "properties": {
              "language": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "expression": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "unique": {
            "type": "boolean"
          },
          "include": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/elementRef"
            }
          }
        }
      }
    }
  },
  "semantics": "CONTRACT-042. Layout and index choices are physical only; they never alter logical identity or field meaning. Unknown content remains recoverable. Target support needs separate qualified evidence.",
  "scopes": [
    "document"
  ],
  "capabilities": {
    "validation": "semantic",
    "directions": [],
    "evidence": [
      "tests/binding/package.test.ts"
    ]
  }
}
