{
  "type": "object",
  "properties": {
    "protocol": {
      "const": "umf.actions.plan/1"
    },
    "model": {
      "$ref": "urn:umf:actions:plan:1#/$defs/model"
    },
    "source": {
      "$ref": "urn:umf:actions:plan:1#/$defs/artifact"
    },
    "selection": {
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "urn:umf:actions:plan:1#/$defs/profile"
        },
        "artifact": {
          "$ref": "urn:umf:actions:plan:1#/$defs/artifact"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "urn:umf:actions:plan:1#/$defs/field"
          },
          "minItems": 0,
          "maxItems": 256
        }
      },
      "required": [
        "profile",
        "artifact",
        "dependencies"
      ],
      "additionalProperties": true
    },
    "action": {
      "$ref": "urn:umf:actions:plan:1#/$defs/action"
    },
    "target": {
      "$ref": "urn:umf:actions:plan:1#/$defs/key"
    },
    "inputs": {
      "type": "object",
      "properties": {
        "entityParameter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "assignments": {
          "type": "array",
          "items": {
            "$ref": "urn:umf:actions:plan:1#/$defs/assignment"
          },
          "minItems": 1,
          "maxItems": 64
        }
      },
      "required": [
        "entityParameter",
        "assignments"
      ],
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "properties": {
        "selection": {
          "const": "frozen"
        },
        "atomicity": {
          "const": "batch"
        },
        "conflict": {
          "const": "stop"
        },
        "partition": {
          "const": "manifest-order"
        },
        "batchSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "selection",
        "atomicity",
        "conflict",
        "partition",
        "batchSize"
      ],
      "additionalProperties": true
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxManifestBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      },
      "required": [
        "maxItems",
        "maxManifestBytes"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "type": "object"
    }
  },
  "required": [
    "protocol",
    "model",
    "source",
    "selection",
    "action",
    "target",
    "inputs",
    "execution",
    "limits"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:actions:plan:1",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": true
    },
    "field": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "element": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "module",
        "element"
      ],
      "additionalProperties": true
    },
    "key": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "element": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "module",
        "element",
        "key"
      ],
      "additionalProperties": true
    },
    "identity": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "module",
        "action"
      ],
      "additionalProperties": true
    },
    "artifact": {
      "type": "object",
      "properties": {
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "utf8": {
          "type": "string",
          "maxLength": 1048576
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "mediaType",
        "utf8",
        "sha256"
      ],
      "additionalProperties": true
    },
    "model": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "umfVersion": {
          "const": "0.10.0"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "documentId",
        "revision",
        "umfVersion",
        "sha256"
      ],
      "additionalProperties": true
    },
    "action": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "urn:umf:actions:plan:1#/$defs/identity"
        },
        "documentSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "invocation": {
          "$ref": "urn:umf:actions:plan:1#/$defs/profile"
        }
      },
      "required": [
        "identity",
        "documentSha256",
        "invocation"
      ],
      "additionalProperties": true
    },
    "assignment": {
      "type": "object",
      "properties": {
        "input": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "field": {
          "$ref": "urn:umf:actions:plan:1#/$defs/field"
        },
        "value": {
          "$ref": "urn:umf:core:0.10.0#/$defs/literal"
        }
      },
      "required": [
        "input",
        "field",
        "value"
      ],
      "additionalProperties": true
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "required": [
        "code",
        "path",
        "message"
      ],
      "additionalProperties": true
    }
  }
}
