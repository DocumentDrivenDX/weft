{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umf:core:semantic-type-reference:1.0.0",
  "description": "UMF language semanticType",
  "type": "object",
  "required": [
    "vocabulary",
    "version",
    "term"
  ],
  "properties": {
    "vocabulary": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "term": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "document": {
      "description": "A Document groups Modules and declares the vocabularies used by its extension content. Its identifier names the complete metadata envelope.",
      "type": "object",
      "required": [
        "umf",
        "id",
        "vocabularies",
        "modules"
      ],
      "properties": {
        "umf": {
          "const": "0.10.0"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "vocabularies": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "version"
            ],
            "properties": {
              "version": {
                "$ref": "#/$defs/version"
              }
            }
          },
          "propertyNames": {
            "$ref": "#/$defs/id"
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/module"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "title": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "id": {
      "description": "UMF language id",
      "type": "string",
      "minLength": 1
    },
    "version": {
      "description": "UMF language version",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "knownScalarType": {
      "description": "Value families; bits128 and uuid have intrinsic16-byte domains under umf-128/1. Native refinements remain attached.",
      "enum": [
        "boolean",
        "integer",
        "decimal",
        "float",
        "string",
        "binary",
        "date",
        "time",
        "timestamp",
        "bits128",
        "uuid"
      ]
    },
    "scalarType": {
      "description": "UMF language scalarType",
      "anyOf": [
        {
          "$ref": "#/$defs/knownScalarType"
        },
        {
          "description": "Unknown family retained with incomplete semantic validation.",
          "allOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "not": {
                "$ref": "#/$defs/knownScalarType"
              }
            }
          ]
        }
      ]
    },
    "extensions": {
      "description": "UMF language extensions",
      "type": "object",
      "properties": {},
      "additionalProperties": true,
      "propertyNames": {
        "$ref": "#/$defs/id"
      }
    },
    "reference": {
      "description": "UMF language reference",
      "type": "object",
      "required": [
        "role",
        "module",
        "element"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/id"
        },
        "module": {
          "$ref": "#/$defs/id"
        },
        "element": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "element": {
      "description": "An Element describes a Field, Record or Group within a Module. References connect Elements without assuming a particular storage or compute implementation.",
      "type": "object",
      "required": [
        "id",
        "extensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "scalarType": {
          "description": "The Field's intrinsic value family. Native representations and external term meanings remain separate.",
          "$ref": "#/$defs/scalarType"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "kind": {
          "description": "UMF role; unknown labels remain uninterpreted. Missing is unspecified, never inferred from scalarType.",
          "type": "string",
          "minLength": 1
        },
        "nullability": {
          "description": "Ideal value availability. Unknown labels remain uninterpreted. Missing and unspecified assert no availability constraint. Native absence carriers require explicit bindings.",
          "type": "string",
          "minLength": 1
        },
        "cardinality": {
          "description": "One ideal value, finite ordered sequence with duplicates allowed, finite exact string-key mapping with unique keys, or no assertion. Unknown labels remain uninterpreted.",
          "type": "string",
          "minLength": 1
        },
        "itemType": {
          "description": "Identifies the Field that describes each array item or map value, using explicit Module and Element identifiers.",
          "$ref": "#/$defs/itemType"
        },
        "facets": {
          "description": "Constrains the values of a Field, including length, numeric width, precision, scale and range.",
          "$ref": "#/$defs/facets"
        },
        "members": {
          "description": "Lists the Elements explicitly contained by a Record or Group.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyFieldReference"
          },
          "uniqueItems": true
        },
        "keys": {
          "description": "Declares named ordered Field tuples that identify values of a Record.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          },
          "minItems": 1
        },
        "title": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/literal"
          }
        },
        "allowedValues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/literal"
          },
          "minItems": 1
        },
        "default": {
          "type": "object",
          "required": [
            "value",
            "on"
          ],
          "properties": {
            "value": {
              "$ref": "#/$defs/literal"
            },
            "on": {
              "enum": [
                "missing",
                "null",
                "missing-or-null"
              ]
            }
          },
          "additionalProperties": true
        },
        "semanticTypes": {
          "type": "array",
          "items": {
            "$ref": "urn:umf:core:semantic-type-reference:1.0.0"
          },
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "record",
                  "group"
                ]
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "scalarType": false
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "nullability"
            ],
            "properties": {
              "nullability": {}
            }
          },
          "then": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "field"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "cardinality"
            ],
            "properties": {
              "cardinality": {}
            }
          },
          "then": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "field"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "cardinality"
            ],
            "properties": {
              "cardinality": {
                "enum": [
                  "array",
                  "map"
                ]
              }
            }
          },
          "then": {
            "not": {
              "type": "object",
              "required": [
                "scalarType"
              ]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "itemType"
            ],
            "properties": {
              "itemType": {}
            }
          },
          "then": {
            "type": "object",
            "required": [
              "kind",
              "cardinality"
            ],
            "properties": {
              "kind": {
                "const": "field"
              },
              "cardinality": {
                "enum": [
                  "array",
                  "map"
                ]
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "facets"
            ],
            "properties": {
              "facets": {}
            }
          },
          "then": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "field"
              },
              "references": {
                "allOf": [
                  {
                    "type": "array"
                  },
                  {
                    "not": {}
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "facets"
            ],
            "properties": {
              "facets": {
                "type": "object",
                "required": [
                  "length"
                ],
                "properties": {
                  "length": {}
                }
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "scalarType"
            ],
            "properties": {
              "scalarType": {
                "enum": [
                  "string",
                  "binary"
                ]
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "facets"
            ],
            "properties": {
              "facets": {
                "type": "object",
                "required": [
                  "length"
                ],
                "properties": {
                  "length": {
                    "type": "object",
                    "required": [
                      "unit"
                    ],
                    "properties": {
                      "unit": {
                        "const": "unicode-scalar"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "scalarType"
            ],
            "properties": {
              "scalarType": {
                "const": "string"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "facets"
            ],
            "properties": {
              "facets": {
                "type": "object",
                "required": [
                  "length"
                ],
                "properties": {
                  "length": {
                    "type": "object",
                    "required": [
                      "unit"
                    ],
                    "properties": {
                      "unit": {
                        "const": "byte"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "scalarType"
            ],
            "properties": {
              "scalarType": {
                "const": "binary"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "facets"
            ],
            "properties": {
              "facets": {
                "type": "object",
                "required": [
                  "precision"
                ],
                "properties": {
                  "precision": {}
                }
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "scalarType"
            ],
            "properties": {
              "scalarType": {
                "const": "decimal"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "facets"
            ],
            "properties": {
              "facets": {
                "type": "object",
                "required": [
                  "integerWidth"
                ],
                "properties": {
                  "integerWidth": {}
                }
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "scalarType"
            ],
            "properties": {
              "scalarType": {
                "const": "integer"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "members"
            ],
            "properties": {
              "members": {}
            }
          },
          "then": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "record"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "keys"
            ],
            "properties": {
              "keys": {}
            }
          },
          "then": {
            "type": "object",
            "required": [
              "kind",
              "members"
            ],
            "properties": {
              "kind": {
                "const": "record"
              },
              "members": {}
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "examples"
            ],
            "properties": {
              "examples": {}
            }
          },
          "then": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "field"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "allowedValues"
            ],
            "properties": {
              "allowedValues": {}
            }
          },
          "then": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "field"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "default"
            ],
            "properties": {
              "default": {}
            }
          },
          "then": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "field"
              }
            }
          }
        }
      ]
    },
    "module": {
      "description": "A Module gives Elements and Relationships a namespace within a Document.",
      "type": "object",
      "required": [
        "id",
        "namespace",
        "elements"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "namespace": {
          "type": "string"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "title": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "knownElementKind": {
      "description": "UMF language knownElementKind",
      "enum": [
        "field",
        "record",
        "group"
      ]
    },
    "knownNullability": {
      "description": "UMF language knownNullability",
      "enum": [
        "required",
        "absent-allowed",
        "unspecified"
      ]
    },
    "knownCardinality": {
      "description": "UMF language knownCardinality",
      "enum": [
        "one",
        "array",
        "map",
        "unspecified"
      ]
    },
    "itemType": {
      "description": "UMF language itemType",
      "type": "object",
      "required": [
        "module",
        "element"
      ],
      "properties": {
        "module": {
          "$ref": "#/$defs/id"
        },
        "element": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "facets": {
      "description": "Missing members impose no bound. Unknown members and qualifiers are retained without interpretation.",
      "type": "object",
      "properties": {
        "length": {
          "type": "object",
          "required": [
            "unit"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true,
          "allOf": [
            {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "min"
                  ],
                  "properties": {
                    "min": {}
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "max"
                  ],
                  "properties": {
                    "max": {}
                  }
                }
              ]
            }
          ]
        },
        "precision": {
          "description": "Decimal coefficient digit bound; requires scale. Absolute coefficient is less than 10^precision. No implicit rounding.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "scale": {
          "description": "Fixed fractional digit count; requires precision. Semantic validation requires scale <= precision. Value equals integer coefficient times 10^-scale.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "integerWidth": {
          "description": "Signed [-2^(bits-1),2^(bits-1)-1] or unsigned [0,2^bits-1]; mathematical domain, not a physical storage-width assertion.",
          "type": "object",
          "required": [
            "bits",
            "signed"
          ],
          "properties": {
            "bits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "signed": {
              "type": "boolean"
            }
          }
        },
        "collectionSize": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": true,
          "allOf": [
            {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "min"
                  ],
                  "properties": {
                    "min": {}
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "max"
                  ],
                  "properties": {
                    "max": {}
                  }
                }
              ]
            }
          ]
        },
        "range": {
          "type": "object",
          "properties": {
            "min": {
              "$ref": "#/$defs/literal"
            },
            "max": {
              "$ref": "#/$defs/literal"
            },
            "minInclusive": {
              "type": "boolean"
            },
            "maxInclusive": {
              "type": "boolean"
            }
          },
          "additionalProperties": true,
          "allOf": [
            {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "min"
                  ],
                  "properties": {
                    "min": {}
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "max"
                  ],
                  "properties": {
                    "max": {}
                  }
                }
              ]
            }
          ]
        }
      },
      "dependentRequired": {
        "precision": [
          "scale"
        ],
        "scale": [
          "precision"
        ]
      }
    },
    "keyFieldReference": {
      "description": "UMF language keyFieldReference",
      "type": "object",
      "required": [
        "module",
        "element"
      ],
      "properties": {
        "module": {
          "$ref": "#/$defs/id"
        },
        "element": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": true
    },
    "key": {
      "description": "UMF language key",
      "type": "object",
      "required": [
        "id",
        "name",
        "fields"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/id"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyFieldReference"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "primary": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "relationshipEndpoint": {
      "description": "UMF language relationshipEndpoint",
      "type": "object",
      "required": [
        "module",
        "element"
      ],
      "properties": {
        "module": {
          "$ref": "#/$defs/id"
        },
        "element": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": true
    },
    "relationshipTarget": {
      "description": "UMF language relationshipTarget",
      "type": "object",
      "required": [
        "module",
        "element",
        "key"
      ],
      "properties": {
        "module": {
          "$ref": "#/$defs/id"
        },
        "element": {
          "$ref": "#/$defs/id"
        },
        "key": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": true
    },
    "relationshipMultiplicity": {
      "description": "UMF language relationshipMultiplicity",
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "const": "*"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "relationship": {
      "description": "UMF language relationship",
      "type": "object",
      "required": [
        "id",
        "name",
        "source",
        "target",
        "sourceMultiplicity",
        "targetMultiplicity",
        "targetLifecycle",
        "directed"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationshipEndpoint"
          },
          "minItems": 1
        },
        "target": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationshipTarget"
          },
          "minItems": 1
        },
        "sourceMultiplicity": {
          "$ref": "#/$defs/relationshipMultiplicity"
        },
        "targetMultiplicity": {
          "$ref": "#/$defs/relationshipMultiplicity"
        },
        "targetLifecycle": {
          "type": "string",
          "minLength": 1
        },
        "directed": {
          "type": "boolean"
        },
        "inverse": {
          "$ref": "#/$defs/id"
        },
        "associationRecord": {
          "$ref": "#/$defs/relationshipEndpoint"
        }
      },
      "additionalProperties": true
    },
    "literal": {
      "description": "UMF language literal",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "boolean"
