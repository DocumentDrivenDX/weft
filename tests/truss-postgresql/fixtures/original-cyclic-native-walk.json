  "sql": "SELECT (WITH RECURSIVE metadata AS (SELECT $4::pg_catalog.jsonb AS v),\n    raw AS (SELECT x AS r FROM pg_catalog.jsonb_array_elements((SELECT COALESCE(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_array(weft_tree_node.\"state_id\"::pg_catalog.text,weft_tree_node.\"node_id\"::pg_catalog.text,weft_tree_node.\"parent_node_id\"::pg_catalog.text,weft_tree_node.\"value_kind\"::pg_catalog.text,weft_tree_node.\"slot_kind\"::pg_catalog.text,weft_tree_node.\"sequence_ordinal\"::pg_catalog.text,weft_tree_node.\"map_key\"::pg_catalog.text,pg_catalog.encode(weft_tree_node.\"record_field_identity_bytes\",'hex'),pg_catalog.encode(weft_tree_node.\"definition_bytes\",'hex'),pg_catalog.encode(weft_tree_node.\"source_bytes\",'hex'),weft_tree_scalar.\"state_id\"::pg_catalog.text,weft_tree_scalar.\"node_id\"::pg_catalog.text,weft_tree_scalar.\"scalar_kind\"::pg_catalog.text,weft_tree_scalar.\"text_value\"::pg_catalog.text,weft_tree_scalar.\"boolean_value\"::pg_catalog.text,weft_tree_scalar.\"numeric_value\"::pg_catalog.text,weft_tree_scalar.\"numeric_token\"::pg_catalog.text,weft_tree_scalar.\"temporal_text\"::pg_catalog.text,weft_tree_scalar.\"temporal_instant\"::pg_catalog.text,pg_catalog.encode(weft_tree_scalar.\"binary_value\",'hex'),pg_catalog.encode(weft_tree_scalar.\"opaque_bytes\",'hex'),pg_catalog.encode(weft_tree_scalar.\"codec_definition_bytes\",'hex'),pg_catalog.encode(weft_tree_scalar.\"original_source_bytes\",'hex'))), '[]'::jsonb) FROM \"pg_temp\".\"row_home_node\" weft_tree_node FULL JOIN \"pg_temp\".\"row_home_scalar\" weft_tree_scalar ON weft_tree_node.\"state_id\"=weft_tree_scalar.\"state_id\" AND weft_tree_node.\"node_id\"=weft_tree_scalar.\"node_id\" WHERE COALESCE(weft_tree_node.\"state_id\",weft_tree_scalar.\"state_id\")=\"weft_state_0\".\"state_id\")) x),\n    walk(r,i,path,depth) AS (\n      SELECT r,(metadata.v->>'root')::int,ARRAY[]::text[],0 FROM raw,metadata\n      WHERE r->>2 IS NULL AND r->>4='root' AND r->>1 IS NOT NULL\n      UNION ALL\n      SELECT child.r,next.i,w.path||next.key,w.depth+1\n      FROM walk w CROSS JOIN metadata\n      CROSS JOIN LATERAL (SELECT metadata.v->'nodes'->w.i->'shape' AS shape) original\n      CROSS JOIN LATERAL (SELECT CASE WHEN original.shape->>'kind'='structured'\n        THEN metadata.v->'nodes'->(original.shape->>'record')::int->'shape'\n        ELSE original.shape END AS shape) container\n      JOIN raw child ON child.r->>2=w.r->>1 AND child.r->>0=w.r->>0\n      CROSS JOIN LATERAL (\n        SELECT (container.shape->>'item')::int AS i,child.r->>5 AS key\n        WHERE container.shape->>'kind'='sequence' AND w.r->>3='sequence' AND child.r->>4='sequence'\n        UNION ALL SELECT (container.shape->>'item')::int,child.r->>6\n        WHERE container.shape->>'kind'='map' AND w.r->>3='map' AND child.r->>4='map'\n        UNION ALL SELECT (member->>'valueNode')::int,member->>'storedName'\n        FROM pg_catalog.jsonb_array_elements(COALESCE(container.shape->'members','[]'::jsonb)) member\n        WHERE container.shape->>'kind'='record' AND w.r->>3 IN ('structured','record')\n          AND child.r->>4='record' AND child.r->>7=member->>'identityHex'\n      ) next WHERE w.depth<128\n    )\n    SELECT pg_catalog.jsonb_build_object('rows',COALESCE((SELECT pg_catalog.jsonb_agg(\n      pg_catalog.jsonb_build_object('cells',r,'logicalNode',i,'path',path,'depth',depth) ORDER BY depth,path) FROM walk),'[]'::jsonb),\n      'unmatchedRows',(SELECT count(*) FROM raw)-(SELECT count(*) FROM walk),\n      'uniqueNodes',(SELECT count(*) FROM raw)=(SELECT count(DISTINCT (r->>0,r->>1)) FROM raw),\n      'matchingShapes',COALESCE((SELECT bool_and(CASE metadata.v->'nodes'->i->'shape'->>'kind'\n        WHEN 'scalar' THEN r->>3 IN ('scalar','null') ELSE r->>3=metadata.v->'nodes'->i->'shape'->>'kind' END) FROM walk,metadata),FALSE))\n    ) AS mapping FROM \"pg_temp\".\"object\" AS \"weft_scan_0\" LEFT JOIN \"pg_temp\".\"row_home_state\" AS \"weft_state_0\" ON \"weft_state_0\".\"owner_kind\"='object' AND \"weft_state_0\".\"object_id\"=\"weft_scan_0\".\"id\" AND \"weft_state_0\".\"object_type_id\"=\"weft_scan_0\".\"type_id\" AND \"weft_state_0\".\"property_owner_type_id\"=$2::pg_catalog.int4 AND \"weft_state_0\".\"property_id\"=$3::pg_catalog.int4 LEFT JOIN \"pg_temp\".\"row_home_node\" AS \"weft_node_0\" ON \"weft_node_0\".\"state_id\"=\"weft_state_0\".\"state_id\" AND \"weft_node_0\".\"node_id\"=\"weft_state_0\".\"root_node_id\" LEFT JOIN \"pg_temp\".\"row_home_scalar\" AS \"weft_scalar_0\" ON \"weft_scalar_0\".\"state_id\"=\"weft_node_0\".\"state_id\" AND \"weft_scalar_0\".\"node_id\"=\"weft_node_0\".\"node_id\" WHERE (\"weft_scan_0\".\"type_id\" = $1::pg_catalog.int4)"
