{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "resource1": {
      "title": "Proposed compiled-read host context requirements",
      "description": "Static obligations only, never serialized authority, snapshot or transaction handles. Actual host admission and native profile evidence remain required.",
      "type": "object",
      "properties": {
        "interfaceVersion": {
          "const": "truss-read-context-definition/0.1.0"
        },
        "profile": {
          "$ref": "#/$defs/resource0/$defs/profilePin"
        },
        "contextSchema": {
          "const": "urn:truss:draft:direct-cursor:0.1.0#/$defs/context"
        },
        "allowedConsistency": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "live",
              "held_snapshot"
            ]
          }
        },
        "catalogAdmission": {
          "const": "original-binding-matches-admitted-view"
        },
        "layoutAdmission": {
          "const": "original-physical-and-encoding-profiles-match"
        },
        "authorityAdmission": {
          "const": "actual-current-role-and-effective-policy"
        },
        "transactionAdmission": {
          "const": "executor-issued-live-affine-context"
        },
        "snapshotAdmission": {
          "const": "original-registry-custody-and-retained-stores"
        },
        "publicationAdmission": {
          "const": "complete-result-current-disclosure-and-resource-check"
        },
        "onMismatch": {
          "const": "refuse-before-sql"
        },
        "resourceProfile": {
          "$ref": "#/$defs/resource0/$defs/profilePin"
        },
        "resourceDefinition": {
          "$ref": "#/$defs/resource0/$defs/exactArtifact"
        },
        "requiredHostObligations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "interfaceVersion",
        "profile",
        "contextSchema",
        "allowedConsistency",
        "catalogAdmission",
        "layoutAdmission",
        "authorityAdmission",
        "transactionAdmission",
        "snapshotAdmission",
        "publicationAdmission",
        "onMismatch",
        "resourceProfile",
        "resourceDefinition",
        "requiredHostObligations"
      ],
      "additionalProperties": false
    },
    "resource0": {
      "title": "Proposed Truss complete acceptance input",
      "description": "Shape validation only. Duplicate JSON members, Unicode scalar validity, canonical base64, digest verification, document ordering/uniqueness, upstream validity, resource limits and authority require separate semantic validation.",
      "type": "object",
      "properties": {
        "interfaceVersion": {
          "const": "truss-acceptance-input/0.1.0"
        },
        "layoutProfile": {
          "$ref": "#/$defs/resource0/$defs/profilePin"
        },
        "acceptanceProfile": {
          "$ref": "#/$defs/resource0/$defs/profilePin"
        },
        "validatorProfile": {
          "$ref": "#/$defs/resource0/$defs/profilePin"
        },
        "supportProfile": {
          "$ref": "#/$defs/resource0/$defs/profilePin"
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resource0/$defs/document"
          }
        },
        "binding": {
          "$ref": "#/$defs/resource0/$defs/binding"
        },
        "policy": {
          "$ref": "#/$defs/resource0/$defs/policy"
        },
        "transforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource0/$defs/transform"
          }
        }
      },
      "required": [
        "interfaceVersion",
        "layoutProfile",
        "acceptanceProfile",
        "validatorProfile",
        "supportProfile",
        "documents",
        "binding",
        "policy",
        "transforms"
      ],
      "additionalProperties": false,
      "$defs": {
        "profilePin": {
          "type": "object",
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "identity",
            "version",
            "sha256"
          ],
          "additionalProperties": false
        },
        "exactArtifact": {
          "type": "object",
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 1
            },
            "bytesBase64": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "identity",
            "bytesBase64",
            "sha256"
          ],
          "additionalProperties": false
        },
        "canonicalTree": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/resource0/$defs/canonicalTree"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/resource0/$defs/canonicalTree"
              }
            }
          ]
        },
        "ingress": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "native"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "converted"
                },
                "adapterProfile": {
                  "$ref": "#/$defs/resource0/$defs/profilePin"
                },
                "source": {
                  "$ref": "#/$defs/resource0/$defs/exactArtifact"
                },
                "lossReport": {
                  "$ref": "#/$defs/resource0/$defs/exactArtifact"
                }
              },
              "required": [
                "kind",
                "adapterProfile",
                "source",
                "lossReport"
              ],
              "additionalProperties": false
            }
          ]
        },
        "document": {
          "type": "object",
          "properties": {
            "documentId": {
              "type": "string",
              "minLength": 1
            },
            "documentRevision": {
              "type": "string",
              "minLength": 1
            },
            "artifact": {
              "$ref": "#/$defs/resource0/$defs/exactArtifact"
            },
            "umfProfile": {
              "$ref": "#/$defs/resource0/$defs/profilePin"
            },
            "ingress": {
              "$ref": "#/$defs/resource0/$defs/ingress"
            }
          },
          "required": [
            "documentId",
            "documentRevision",
            "artifact",
            "umfProfile",
            "ingress"
          ],
          "additionalProperties": false
        },
        "binding": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "absent"
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "present"
                },
                "vocabulary": {
                  "$ref": "#/$defs/resource0/$defs/profilePin"
                },
                "artifact": {
                  "$ref": "#/$defs/resource0/$defs/exactArtifact"
                }
              },
              "required": [
                "state",
                "vocabulary",
                "artifact"
              ],
              "additionalProperties": false
            }
          ]
        },
        "policy": {
          "type": "object",
          "properties": {
            "unknownEndpoint": {
              "enum": [
                "reject",
                "provisional",
                "skip"
              ]
            },
            "loss": {
              "enum": [
                "strict",
                "report"
              ]
            },
            "profile": {
              "$ref": "#/$defs/resource0/$defs/profilePin"
            }
          },
          "required": [
            "unknownEndpoint",
            "loss",
            "profile"
          ],
          "additionalProperties": false
        },
        "transform": {
          "type": "object",
          "properties": {
            "registration": {
              "$ref": "#/$defs/resource0/$defs/profilePin"
            },
            "targetDefinitionIdentity": {
              "type": "string",
              "minLength": 1
            },
            "parameters": {
              "$ref": "#/$defs/resource0/$defs/canonicalTree"
            }
          },
          "required": [
            "registration",
            "targetDefinitionIdentity",
            "parameters"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/resource1"
    }
  ]
}
