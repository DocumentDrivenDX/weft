{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "resource1": {
      "title": "Proposed exact JSONB leaf codec definition",
      "description": "Interpretation rules for selected string/boolean and conditional ADR-006 numeric token codecs only. No native qualification, numeric adoption or universal scalar support.",
      "type": "object",
      "properties": {
        "interfaceVersion": {
          "const": "truss-jsonb-leaf-codec/0.1.0"
        },
        "profile": {
          "$ref": "#/$defs/resource0/$defs/profilePin"
        },
        "authoredDefinition": {
          "$ref": "#/$defs/resource0/$defs/exactArtifact"
        },
        "sourceInterpretationProfile": {
          "$ref": "#/$defs/resource0/$defs/profilePin"
        },
        "sourceInterpretationDefinition": {
          "$ref": "#/$defs/resource0/$defs/exactArtifact"
        },
        "nativeDomainProfile": {
          "$ref": "#/$defs/resource0/$defs/profilePin"
        },
        "nativeDomainDefinition": {
          "$ref": "#/$defs/resource0/$defs/exactArtifact"
        },
        "rule": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "family": {
                  "const": "string"
                },
                "storageRepresentation": {
                  "const": "json-string"
                },
                "encoding": {
                  "const": "preserve-unicode-scalars"
                },
                "decodedCarrierKind": {
                  "const": "string"
                }
              },
              "required": [
                "family",
                "storageRepresentation",
                "encoding",
                "decodedCarrierKind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "family": {
                  "const": "boolean"
                },
                "storageRepresentation": {
                  "const": "json-boolean"
                },
                "encoding": {
                  "const": "preserve-boolean"
                },
                "decodedCarrierKind": {
                  "const": "boolean"
                }
              },
              "required": [
                "family",
                "storageRepresentation",
                "encoding",
                "decodedCarrierKind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "family": {
                  "enum": [
                    "integer",
                    "decimal"
                  ]
                },
                "storageRepresentation": {
                  "const": "json-string"
                },
                "encoding": {
                  "const": "preserve-admitted-source-token"
                },
                "decodedCarrierKind": {
                  "enum": [
                    "integer",
                    "decimal"
                  ]
                },
                "numericAdoptionEvidence": {
                  "$ref": "#/$defs/resource0/$defs/exactArtifact"
                }
              },
              "required": [
                "family",
                "storageRepresentation",
                "encoding",
                "decodedCarrierKind",
                "numericAdoptionEvidence"
              ],
              "additionalProperties": false
            }
          ]
        },
        "coercion": {
          "const": "none"
        },
        "readDefault": {
          "const": "none"
        },
        "invalidStoredValue": {
          "const": "complete-result-refusal"
        }
      },
      "required": [
        "interfaceVersion",
        "profile",
        "authoredDefinition",
        "sourceInterpretationProfile",
        "sourceInterpretationDefinition",
        "nativeDomainProfile",
        "nativeDomainDefinition",
        "rule",
        "coercion",
        "readDefault",
        "invalidStoredValue"
      ],
      "additionalProperties": false
    },
    "resource0": {
      "title": "Proposed Truss complete acceptance input",
      "description": "Shape validation only. Duplicate JSON members, Unicode scalar validity, canonical base64, digest verification, document ordering/uniqueness, upstream validity, resource limits and authority require separate semantic validation.",
      "type": "object",
      "properties": {
        "interfaceVersion": {
          "const": "truss-acceptance-input/0.1.0"
        },
        "layoutProfile": {
          "$ref": "#/$defs/resource0/$defs/profilePin"
        },
        "acceptanceProfile": {
          "$ref": "#/$defs/resource0/$defs/profilePin"
        },
        "validatorProfile": {
          "$ref": "#/$defs/resource0/$defs/profilePin"
        },
        "supportProfile": {
          "$ref": "#/$defs/resource0/$defs/profilePin"
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resource0/$defs/document"
          }
        },
        "binding": {
          "$ref": "#/$defs/resource0/$defs/binding"
        },
        "policy": {
          "$ref": "#/$defs/resource0/$defs/policy"
        },
        "transforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource0/$defs/transform"
          }
        }
      },
      "required": [
        "interfaceVersion",
        "layoutProfile",
        "acceptanceProfile",
        "validatorProfile",
        "supportProfile",
        "documents",
        "binding",
        "policy",
        "transforms"
      ],
      "additionalProperties": false,
      "$defs": {
        "profilePin": {
          "type": "object",
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "identity",
            "version",
            "sha256"
          ],
          "additionalProperties": false
        },
        "exactArtifact": {
          "type": "object",
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 1
            },
            "bytesBase64": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "identity",
            "bytesBase64",
            "sha256"
          ],
          "additionalProperties": false
        },
        "canonicalTree": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/resource0/$defs/canonicalTree"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/resource0/$defs/canonicalTree"
              }
            }
          ]
        },
        "ingress": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "native"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "converted"
                },
                "adapterProfile": {
                  "$ref": "#/$defs/resource0/$defs/profilePin"
                },
                "source": {
                  "$ref": "#/$defs/resource0/$defs/exactArtifact"
                },
                "lossReport": {
                  "$ref": "#/$defs/resource0/$defs/exactArtifact"
                }
              },
              "required": [
                "kind",
                "adapterProfile",
                "source",
                "lossReport"
              ],
              "additionalProperties": false
            }
          ]
        },
        "document": {
          "type": "object",
          "properties": {
            "documentId": {
              "type": "string",
              "minLength": 1
            },
            "documentRevision": {
              "type": "string",
              "minLength": 1
            },
            "artifact": {
              "$ref": "#/$defs/resource0/$defs/exactArtifact"
            },
            "umfProfile": {
              "$ref": "#/$defs/resource0/$defs/profilePin"
            },
            "ingress": {
              "$ref": "#/$defs/resource0/$defs/ingress"
            }
          },
          "required": [
            "documentId",
            "documentRevision",
            "artifact",
            "umfProfile",
            "ingress"
          ],
          "additionalProperties": false
        },
        "binding": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "absent"
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "present"
                },
                "vocabulary": {
                  "$ref": "#/$defs/resource0/$defs/profilePin"
                },
                "artifact": {
                  "$ref": "#/$defs/resource0/$defs/exactArtifact"
                }
              },
              "required": [
                "state",
                "vocabulary",
                "artifact"
              ],
              "additionalProperties": false
            }
          ]
        },
        "policy": {
          "type": "object",
          "properties": {
            "unknownEndpoint": {
              "enum": [
                "reject",
                "provisional",
                "skip"
              ]
            },
            "loss": {
              "enum": [
                "strict",
                "report"
              ]
            },
            "profile": {
              "$ref": "#/$defs/resource0/$defs/profilePin"
            }
          },
          "required": [
            "unknownEndpoint",
            "loss",
            "profile"
          ],
          "additionalProperties": false
        },
        "transform": {
          "type": "object",
          "properties": {
            "registration": {
              "$ref": "#/$defs/resource0/$defs/profilePin"
            },
            "targetDefinitionIdentity": {
              "type": "string",
              "minLength": 1
            },
            "parameters": {
              "$ref": "#/$defs/resource0/$defs/canonicalTree"
            }
          },
          "required": [
            "registration",
            "targetDefinitionIdentity",
            "parameters"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/resource1"
    }
  ]
}
