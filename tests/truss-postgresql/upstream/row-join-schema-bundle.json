{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "resource1": {
      "type": "object",
      "properties": {
        "interfaceVersion": {
          "const": "truss-row-join-definition/0.1.0"
        },
        "profile": {
          "$ref": "#/$defs/resource0/$defs/profilePin"
        },
        "layoutInventory": {
          "$ref": "#/$defs/resource0/$defs/exactArtifact"
        },
        "recordKind": {
          "enum": [
            "object",
            "edge"
          ]
        },
        "owner": {
          "type": "object",
          "properties": {
            "relationPhysicalIdentity": {
              "type": "string",
              "minLength": 1
            },
            "relationName": {
              "enum": [
                "object",
                "edge"
              ]
            },
            "idColumnPhysicalIdentity": {
              "type": "string",
              "minLength": 1
            },
            "discriminatorColumnPhysicalIdentity": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "relationPhysicalIdentity",
            "relationName",
            "idColumnPhysicalIdentity",
            "discriminatorColumnPhysicalIdentity"
          ],
          "additionalProperties": false
        },
        "state": {
          "type": "object",
          "properties": {
            "relationPhysicalIdentity": {
              "type": "string",
              "minLength": 1
            },
            "relationName": {
              "const": "row_home_state"
            },
            "columns": {
              "type": "object",
              "properties": {
                "state_id": {
                  "type": "string",
                  "minLength": 1
                },
                "owner_kind": {
                  "type": "string",
                  "minLength": 1
                },
                "object_id": {
                  "type": "string",
                  "minLength": 1
                },
                "object_type_id": {
                  "type": "string",
                  "minLength": 1
                },
                "edge_id": {
                  "type": "string",
                  "minLength": 1
                },
                "relationship_type_id": {
                  "type": "string",
                  "minLength": 1
                },
                "property_owner_type_id": {
                  "type": "string",
                  "minLength": 1
                },
                "property_id": {
                  "type": "string",
                  "minLength": 1
                },
                "root_node_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "state_id",
                "owner_kind",
                "object_id",
                "object_type_id",
                "edge_id",
                "relationship_type_id",
                "property_owner_type_id",
                "property_id",
                "root_node_id"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "relationPhysicalIdentity",
            "relationName",
            "columns"
          ],
          "additionalProperties": false
        },
        "node": {
          "type": "object",
          "properties": {
            "relationPhysicalIdentity": {
              "type": "string",
              "minLength": 1
            },
            "relationName": {
              "const": "row_home_node"
            },
            "columns": {
              "type": "object",
              "properties": {
                "state_id": {
                  "type": "string",
                  "minLength": 1
                },
                "node_id": {
                  "type": "string",
                  "minLength": 1
                },
                "parent_node_id": {
                  "type": "string",
                  "minLength": 1
                },
                "value_kind": {
                  "type": "string",
                  "minLength": 1
                },
                "slot_kind": {
                  "type": "string",
                  "minLength": 1
                },
                "sequence_ordinal": {
                  "type": "string",
                  "minLength": 1
                },
                "map_key": {
                  "type": "string",
                  "minLength": 1
                },
                "record_field_identity_bytes": {
                  "type": "string",
                  "minLength": 1
                },
                "definition_bytes": {
                  "type": "string",
                  "minLength": 1
                },
                "source_bytes": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "state_id",
                "node_id",
                "parent_node_id",
                "value_kind",
                "slot_kind",
                "sequence_ordinal",
                "map_key",
                "record_field_identity_bytes",
                "definition_bytes",
                "source_bytes"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "relationPhysicalIdentity",
            "relationName",
            "columns"
          ],
          "additionalProperties": false
        },
        "scalar": {
          "type": "object",
          "properties": {
            "relationPhysicalIdentity": {
              "type": "string",
              "minLength": 1
            },
            "relationName": {
              "const": "row_home_scalar"
            },
            "columns": {
              "type": "object",
              "properties": {
                "state_id": {
                  "type": "string",
                  "minLength": 1
                },
                "node_id": {
                  "type": "string",
                  "minLength": 1
                },
                "scalar_kind": {
                  "type": "string",
                  "minLength": 1
                },
                "text_value": {
                  "type": "string",
                  "minLength": 1
                },
                "boolean_value": {
                  "type": "string",
                  "minLength": 1
                },
                "numeric_value": {
                  "type": "string",
                  "minLength": 1
                },
                "numeric_token": {
                  "type": "string",
                  "minLength": 1
                },
                "binary_value": {
                  "type": "string",
                  "minLength": 1
                },
                "temporal_text": {
                  "type": "string",
                  "minLength": 1
                },
                "temporal_instant": {
                  "type": "string",
                  "minLength": 1
                },
                "opaque_bytes": {
                  "type": "string",
                  "minLength": 1
                },
                "codec_definition_bytes": {
                  "type": "string",
                  "minLength": 1
                },
                "original_source_bytes": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "state_id",
                "node_id",
                "scalar_kind",
                "text_value",
                "boolean_value",
                "numeric_value",
                "numeric_token",
                "binary_value",
                "temporal_text",
                "temporal_instant",
                "opaque_bytes",
                "codec_definition_bytes",
                "original_source_bytes"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "relationPhysicalIdentity",
            "relationName",
            "columns"
          ],
          "additionalProperties": false
        },
        "ownerJoin": {
          "enum": [
            "object-id-and-type",
            "edge-id-and-relationship"
          ]
        },
        "stateSelection": {
          "const": "owner-kind-and-independent-property-owner-and-property"
        },
        "rootJoin": {
          "const": "state-id-and-root-node-id-to-node-state-id-and-node-id"
        },
        "payloadJoin": {
          "const": "root-state-id-and-node-id-to-scalar-state-id-and-node-id"
        },
        "ownerMultiplicity": {
          "const": "preserve-each-admitted-owner-occurrence"
        },
        "optionalAbsence": {
          "const": "complete-authorized-state-absence"
        },
        "requiredAbsence": {
          "const": "integrity-refusal"
        },
        "nullRoot": {
          "const": "present-null-with-zero-scalar-payloads"
        },
        "scalarRoot": {
          "const": "present-scalar-with-exactly-one-qualified-payload"
        },
        "containerRoot": {
          "const": "complete-value-tree-only"
        },
        "invalidObservation": {
          "const": "whole-result-integrity-refusal"
        },
        "authorityView": {
          "const": "same-original-admitted-catalog-authority-and-snapshot"
        },
        "integrityAdmission": {
          "const": "qualified-stored-domain-before-publication-independent-of-predicate-order"
        },
        "constraintEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resource0/$defs/exactArtifact"
          }
        },
        "storedDomainDefinition": {
          "$ref": "#/$defs/resource0/$defs/exactArtifact"
        },
        "edgeAssociationDefinition": {
          "$ref": "#/$defs/resource0/$defs/exactArtifact"
        }
      },
      "required": [
        "interfaceVersion",
        "profile",
        "layoutInventory",
        "recordKind",
        "owner",
        "state",
        "node",
        "scalar",
        "ownerJoin",
        "stateSelection",
        "rootJoin",
        "payloadJoin",
        "ownerMultiplicity",
        "optionalAbsence",
        "requiredAbsence",
        "nullRoot",
        "scalarRoot",
        "containerRoot",
        "invalidObservation",
        "authorityView",
        "integrityAdmission",
        "constraintEvidence",
        "storedDomainDefinition"
      ],
      "additionalProperties": false,
      "title": "Proposed fixed row-home join definition",
      "description": "Closed selectors and original physical IDs; not SQL, an authority handle, or evidence of native join/integrity support.",
      "allOf": [
        {
          "if": {
            "properties": {
              "recordKind": {
                "const": "object"
              }
            }
          },
          "then": {
            "properties": {
              "ownerJoin": {
                "const": "object-id-and-type"
              },
              "owner": {
                "properties": {
                  "relationName": {
                    "const": "object"
                  }
                },
                "type": "object"
              }
            },
            "not": {
              "required": [
                "edgeAssociationDefinition"
              ],
              "properties": {
                "edgeAssociationDefinition": {}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recordKind": {
                "const": "edge"
              }
            }
          },
          "then": {
            "properties": {
              "ownerJoin": {
                "const": "edge-id-and-relationship"
              },
              "owner": {
                "properties": {
                  "relationName": {
                    "const": "edge"
                  }
                },
                "type": "object"
              },
              "edgeAssociationDefinition": {}
            },
            "required": [
              "edgeAssociationDefinition"
            ]
          }
        }
      ]
    },
    "resource0": {
      "title": "Proposed Truss complete acceptance input",
      "description": "Shape validation only. Duplicate JSON members, Unicode scalar validity, canonical base64, digest verification, document ordering/uniqueness, upstream validity, resource limits and authority require separate semantic validation.",
      "type": "object",
      "properties": {
        "interfaceVersion": {
          "const": "truss-acceptance-input/0.1.0"
        },
        "layoutProfile": {
          "$ref": "#/$defs/resource0/$defs/profilePin"
        },
        "acceptanceProfile": {
          "$ref": "#/$defs/resource0/$defs/profilePin"
        },
        "validatorProfile": {
          "$ref": "#/$defs/resource0/$defs/profilePin"
        },
        "supportProfile": {
          "$ref": "#/$defs/resource0/$defs/profilePin"
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resource0/$defs/document"
          }
        },
        "binding": {
          "$ref": "#/$defs/resource0/$defs/binding"
        },
        "policy": {
          "$ref": "#/$defs/resource0/$defs/policy"
        },
        "transforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource0/$defs/transform"
          }
        }
      },
      "required": [
        "interfaceVersion",
        "layoutProfile",
        "acceptanceProfile",
        "validatorProfile",
        "supportProfile",
        "documents",
        "binding",
        "policy",
        "transforms"
      ],
      "additionalProperties": false,
      "$defs": {
        "profilePin": {
          "type": "object",
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "identity",
            "version",
            "sha256"
          ],
          "additionalProperties": false
        },
        "exactArtifact": {
          "type": "object",
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 1
            },
            "bytesBase64": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "identity",
            "bytesBase64",
            "sha256"
          ],
          "additionalProperties": false
        },
        "canonicalTree": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/resource0/$defs/canonicalTree"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/resource0/$defs/canonicalTree"
              }
            }
          ]
        },
        "ingress": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "native"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "converted"
                },
                "adapterProfile": {
                  "$ref": "#/$defs/resource0/$defs/profilePin"
                },
                "source": {
                  "$ref": "#/$defs/resource0/$defs/exactArtifact"
                },
                "lossReport": {
                  "$ref": "#/$defs/resource0/$defs/exactArtifact"
                }
              },
              "required": [
                "kind",
                "adapterProfile",
                "source",
                "lossReport"
              ],
              "additionalProperties": false
            }
          ]
        },
        "document": {
          "type": "object",
          "properties": {
            "documentId": {
              "type": "string",
              "minLength": 1
            },
            "documentRevision": {
              "type": "string",
              "minLength": 1
            },
            "artifact": {
              "$ref": "#/$defs/resource0/$defs/exactArtifact"
            },
            "umfProfile": {
              "$ref": "#/$defs/resource0/$defs/profilePin"
            },
            "ingress": {
              "$ref": "#/$defs/resource0/$defs/ingress"
            }
          },
          "required": [
            "documentId",
            "documentRevision",
            "artifact",
            "umfProfile",
            "ingress"
          ],
          "additionalProperties": false
        },
        "binding": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "absent"
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "present"
                },
                "vocabulary": {
                  "$ref": "#/$defs/resource0/$defs/profilePin"
                },
                "artifact": {
                  "$ref": "#/$defs/resource0/$defs/exactArtifact"
                }
              },
              "required": [
                "state",
                "vocabulary",
                "artifact"
              ],
              "additionalProperties": false
            }
          ]
        },
        "policy": {
          "type": "object",
          "properties": {
            "unknownEndpoint": {
              "enum": [
                "reject",
                "provisional",
                "skip"
              ]
            },
            "loss": {
              "enum": [
                "strict",
                "report"
              ]
            },
            "profile": {
              "$ref": "#/$defs/resource0/$defs/profilePin"
            }
          },
          "required": [
            "unknownEndpoint",
            "loss",
            "profile"
          ],
          "additionalProperties": false
        },
        "transform": {
          "type": "object",
          "properties": {
            "registration": {
              "$ref": "#/$defs/resource0/$defs/profilePin"
            },
            "targetDefinitionIdentity": {
              "type": "string",
              "minLength": 1
            },
            "parameters": {
              "$ref": "#/$defs/resource0/$defs/canonicalTree"
            }
          },
          "required": [
            "registration",
            "targetDefinitionIdentity",
            "parameters"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/resource1"
    }
  ]
}
